{
    "manifest_version": 3,
    "name": "Mintab",
    "version": "1.0.1",
    "description": "Open to simplicity",
    "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
    "chrome_url_overrides": {
        "newtab": "index.html"
    },
    "permissions": [
        "bookmarks",
        "storage",
        "geolocation"
    ]
}